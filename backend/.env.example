APP_NAME=SecGraph API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://secgraph:secgraph@localhost:5432/secgraph
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STORAGE_DIR=storage/projects
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
MAX_ARCHIVE_MEMBER_BYTES=26214400
MAX_ARCHIVE_MEMBERS=10000
API_AUTH_ENABLED=true
API_KEYS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_COMPLEX_MODEL=deepseek-r1:7b
GROQ_API_KEY=
GROQ_MODEL=deepseek-r1:7b
AI_TIMEOUT_SECONDS=30
# Choose one: ollama (local), groq (cloud), or auto (legacy routing)
AI_PROVIDER=ollama
AI_ROUTING_ENABLED=true
# true skips high-confidence findings at/above the threshold; false analyzes them
AI_SKIP_HIGH_CONFIDENCE=true
AI_STATIC_CONFIDENCE_THRESHOLD=0.85
AI_SIMPLE_CONFIDENCE_THRESHOLD=0.75
AI_COMPLEX_RULE_IDS=possible-idor,sensitive-data-exposure
AI_PREFER_GROQ_FOR_COMPLEX=true
